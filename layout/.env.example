### Public (used for redirect URLs)
PUBLIC_BASE_URL=http://localhost:8080
# Em produção, use o domínio público do site (HTTPS), ex:
# PUBLIC_BASE_URL=https://taizacare.ajudaon.com.br

### Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MAX_INSTALLMENTS=3

### n8n / notificações (opcional)
# URL do workflow do n8n (Webhook Trigger) para avisar quando um pedido ficar PAGO.
N8N_PAID_WEBHOOK_URL=
# Segredo opcional para assinar o payload enviado ao n8n (HMAC-SHA256).
# Assinatura usa o template:
# ts:{timestampMs};order_id:{orderId};payment_id:{paymentId};total_cents:{total};paid_at:{paidAt};
N8N_PAID_WEBHOOK_SECRET=

### Admin (internal)
# Token simples para acessar a lista de pedidos (não é para clientes).
ADMIN_TOKEN=

### Melhor Envio
ME_BASE_URL=https://melhorenvio.com.br
ME_TOKEN=
ME_USER_AGENT=TaizaCare (WhatsApp +55 44 99976-0479)

### Shipping/product defaults
SHIPPING_ORIGIN_POSTAL_CODE=87502080
PRODUCT_SKU=calcinha-pos-parto
PRODUCT_NAME=Calcinha Pós-Parto Taiza Care
PRODUCT_PRICE_PIX_CENTS=10990
CARD_MARKUP_PERCENT=5
PRODUCT_WEIGHT_KG=0.12
PRODUCT_LENGTH_CM=17
PRODUCT_WIDTH_CM=15
PRODUCT_HEIGHT_CM=3
